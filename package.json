{
  "name": "epl-dual-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard EPL 2020/21 untuk penyelenggara dan penonton dengan D3.js dan PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "import": "node server/import-cli.js",
    "build:web": "node scripts/build-web.js",
    "test": "node --test tests/*.test.js",
    "pretest": "node scripts/generate-demo.js"
  },
  "dependencies": {
    "csv-parse": "6.1.0",
    "d3": "7.9.0",
    "express": "5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "jsdom": "26.1.0",
    "tailwindcss": "3.4.17"
  }
}
